# Copy this file to backend/.env and fill in your private Supabase values.
# Supabase Dashboard > Connect > Session pooler provides the host, port, user and database.
SUPABASE_JDBC_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
SUPABASE_DB_USER=<supabase-session-pooler-username>
SUPABASE_DB_PASSWORD=<supabase-database-password>

# Use the exact same random secret in the API gateway and user service.
JWT_SECRET=<random-secret-at-least-32-characters>

# Optional: turn this on to seed 10 courses, 50 sample students and a demo admin.
DEMO_DATA_ENABLED=false
SEED_ADMIN_EMAIL=admin@studybuds.sg
SEED_ADMIN_PASSWORD=<private-demo-admin-password>
SEED_STUDENT_PASSWORD=<private-demo-student-password>
