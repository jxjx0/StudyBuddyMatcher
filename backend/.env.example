# Copy to backend/.env and fill in. Never commit real credentials.
# Every variable, including the optional ones, is documented in backend/README.md.

SUPABASE_JDBC_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
SUPABASE_DB_USER=<supabase-username>
SUPABASE_DB_PASSWORD=<supabase-database-password>

# Both at least 32 characters and different. Joining an existing setup? Use the team's values.
JWT_SECRET=<random-secret-at-least-32-characters>
CONTACT_SERVICE_SECRET=<different-random-secret-at-least-32-characters>

# Optional: seed 10 courses, 50 sample students and a demo admin.
DEMO_DATA_ENABLED=false
SEED_ADMIN_EMAIL=admin@studybuds.sg
SEED_ADMIN_PASSWORD=<private-demo-admin-password>
SEED_STUDENT_PASSWORD=<private-demo-student-password>
