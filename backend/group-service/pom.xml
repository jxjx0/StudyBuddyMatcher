<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.studybuddy</groupId>
    <artifactId>study-buddy-matcher</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>
  <artifactId>group-service</artifactId>
  <name>group-service</name>
  <description>Study groups and group join requests</description>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <!-- Provides the auto-configured RestClient.Builder used by StudentClient
         to call user-service. Not included in the webmvc starter. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- Only Lwin's Study Groups files are formatted. Shared model copies stay untouched. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.10.4</version>
        <configuration>
          <java>
            <includes>
              <include>src/main/java/com/studybuddy/group/client/StudentClient.java</include>
              <include>src/main/java/com/studybuddy/group/config/SecurityConfiguration.java</include>
              <include>src/main/java/com/studybuddy/group/controller/*.java</include>
              <include>src/main/java/com/studybuddy/group/dto/Group*.java</include>
              <include>src/main/java/com/studybuddy/group/dto/JoinRequestView.java</include>
              <include>src/main/java/com/studybuddy/group/model/StudyGroup.java</include>
              <include>src/main/java/com/studybuddy/group/model/GroupJoinRequest.java</include>
              <include>src/main/java/com/studybuddy/group/model/GroupJoinRequestStatus.java</include>
              <include>src/main/java/com/studybuddy/group/model/GroupStatus.java</include>
              <include>src/main/java/com/studybuddy/group/repository/*.java</include>
              <include>src/main/java/com/studybuddy/group/service/*.java</include>
              <include>src/test/java/com/studybuddy/group/*.java</include>
            </includes>
            <googleJavaFormat>
              <version>1.28.0</version>
              <reflowLongStrings>false</reflowLongStrings>
              <formatJavadoc>false</formatJavadoc>
            </googleJavaFormat>
          </java>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
